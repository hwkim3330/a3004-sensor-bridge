config navigate 'nav'
	# Off, and it stays off until a vehicle has actually been driven by
	# hand. This is the one daemon in the kit that decides on its own to
	# move something.
	option enabled '0'

	option ring_port '7602'
	option cmd_port '7604'

	# Where agx-cmd listens. Empty means plan and report but never command,
	# which is the useful setting while the map is being trusted.
	option tele ''


	# 20 m, not 40. Measured on the board: the search does the same number of
	# lookups whatever the map size, but it reads them at random across the
	# grid, and 818 kB does not fit the 1004Kc's cache while 204 kB largely
	# does. 40 m cost 63.4 ms per scan, 20 m costs 29.2 ms for the same match
	# quality - 82% against 84%. 12 m is only slightly faster again, 26.4 ms,
	# and the score falls to 70% because the room starts running off the edge.
	option map_size_cm '2000'
	option resolution_cm '5'
	option max_range_cm '3000'

	# Half the SCOUT MINI's diagonal, roughly. Obstacles are grown by this
	# before planning, so too small is the dangerous direction.
	# Half the vehicle's diagonal, plus room to stop.
	#
	# A SCOUT MINI is 612 x 580 mm, so the half-diagonal is 42 cm - and 40 was
	# below that, which means the planner was routing through gaps the vehicle
	# physically does not fit. It showed up in the simulator as a path passing
	# 17 cm from a wall while the same daemon holds a hand-set goal to 25 cm.
	#
	# 55 cm: 42 for the body, then 13 for the mount, the pose error the mapper
	# admits to (about 8 cm), and the distance covered while a stop propagates.
	option robot_radius_cm '55'
	option arrive_cm '25'

	# Command ceilings, as a percentage of whatever agx-cmd calls full
	# speed. Slow is correct until this has been watched working.
	option max_linear_pct '35'
	option max_yaw_pct '50'

	# The watchers. Each of these stops the vehicle.
	option min_score_pct '25'
	option stall_ms '8000'
	option ring_timeout_ms '1000'

	# Served by the dashboard as /sensors/map.s2mp, for the tablet to draw
	# and to tap a destination on.
	option map_export '/var/run/map.s2mp'
	option map_level '2'
