config navigate 'nav'
	# Off, and it stays off until a vehicle has actually been driven by
	# hand. This is the one daemon in the kit that decides on its own to
	# move something.
	option enabled '0'

	option ring_port '7602'
	option cmd_port '7604'

	# Where agx-cmd listens. Empty means plan and report but never command,
	# which is the useful setting while the map is being trusted.
	option tele ''

	option map_size_cm '4000'
	option resolution_cm '5'
	option max_range_cm '3000'

	# Half the SCOUT MINI's diagonal, roughly. Obstacles are grown by this
	# before planning, so too small is the dangerous direction.
	option robot_radius_cm '40'
	option arrive_cm '25'

	# Command ceilings, as a percentage of whatever agx-cmd calls full
	# speed. Slow is correct until this has been watched working.
	option max_linear_pct '35'
	option max_yaw_pct '50'

	# The watchers. Each of these stops the vehicle.
	option min_score_pct '25'
	option stall_ms '8000'
	option ring_timeout_ms '1000'
