#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

PROG=/usr/sbin/rc-ibus

start_service() {
	local enabled device baud timeout remote status_interval

	config_load rc-ibus
	config_get_bool enabled ibus enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get device ibus device '/dev/ttyUSB0'
	config_get baud   ibus baud 115200
	config_get timeout ibus timeout 200
	config_get remote ibus remote
	config_get status_interval ibus status_interval 100

	if [ ! -e "$device" ]; then
		logger -t rc-ibus "$device does not exist; is the USB-serial adapter plugged in?"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		--device "$device" \
		--baud "$baud" \
		--timeout "$timeout" \
		--status /var/run/rc-ibus.json \
		--status-interval "$status_interval"

	[ -n "$remote" ] && procd_append_param command --remote "$remote"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/rc-ibus.json
}

service_triggers() {
	procd_add_reload_trigger "rc-ibus"
}
