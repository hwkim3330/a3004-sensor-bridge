config rc 'ibus'
	# Off by default: this needs a receiver, a USB-serial adapter, and a free
	# USB port - see doc/RC-AND-WIFI.md.
	option enabled '0'

	option device '/dev/ttyUSB0'

	# i-BUS is 115200 8N1. Do not change this unless you know your receiver
	# does something else; SBUS is 100000 8E2 *inverted* and will not work
	# here without an inverting buffer.
	option baud '115200'

	# Declare the link lost after this long without a valid frame. Frames
	# arrive about every 7.5 ms, so 200 ms is ~25 missed frames.
	option timeout '200'

	# Forward channels as UDP to whatever holds the control loop. Empty
	# disables it; the status file is still written for the dashboard.
	option remote ''

	option status_interval '100'
