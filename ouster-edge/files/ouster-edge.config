config ouster 'lidar'
	option enabled '0'

	# UDP port the sensor sends lidar packets to (Ouster default 7502).
	option port '7502'

	# Sensor IP. Only used to auto-detect the packet layout over the
	# sensor's HTTP API; leave empty to trust the values below.
	option sensor_ip '192.168.1.50'

	# Fallback layout, used when the sensor cannot be reached. 64/16/1024
	# is an OS-64 in 1024x10 mode.
	option channels '64'
	option columns '16'
	option scan_width '1024'

	# Azimuth sectors in the published ring. 360 keeps the datagram inside
	# a 1500-byte MTU; raise it only with jumbo frames on the ring path.
	option sectors '360'

	# What the sensor should be, asserted at every start.
	#
	# Its stored configuration does not survive a reboot, and a wrong one is
	# silent: a 90 degree azimuth_window produced an empty ring, zero matches
	# and healthy-looking counters everywhere. Leave any of these empty to
	# leave that setting alone.
	option want_azimuth_window '0:360000'
	option want_lidar_mode ''
	option want_udp_dest ''

	# Reduce over this channel range only, and leave it empty to have
	# ouster-configure derive it.
	#
	# Empty means the rows within 1.5 degrees of horizontal, read from the
	# sensor's own beam_altitude_angles - 28:33 on the OS-1 here. Those indices
	# are not fixed; they depend on the beam layout. The whole 64 rows cover
	# about +/-22 degrees, and reducing that whole span to one minimum per
	# azimuth makes the ring a picture of the floor once the sensor is on a
	# vehicle.
	#
	# This option was written twice for a while - once empty, once at 20:44 -
	# and the second silently won, so the derivation never happened and nothing
	# said why. Set a value here only to override it deliberately.
	option channel_band ''

	option min_range '0.3'
	option max_range '100'

	# Forward every raw packet here, for a full driver on a real machine.
	# Empty disables relaying.
	option relay ''

	# Send the derived ring here (binary, see doc/RING-FORMAT.md).
	#
	# Space-separated for more than one, up to four: the mapper on this router
	# and an operator's tablet both want it, and with a single destination
	# choosing either leaves the other with a blank panel and no error.
	# The LAN broadcast address, and only that.
	#
	# It reaches the mapper on this router and any operator screen on the access
	# point, with nobody configuring an address - the tablet's comes from DHCP so
	# a shipped default cannot name it.
	#
	# Listing 127.0.0.1 as well, which this did, delivered every ring twice: the
	# router receives its own broadcast. slam2d then matched each revolution
	# twice, at 20.3 rings a second against a 10 Hz sensor, for double the CPU -
	# and worse, the second copy of a scan has no motion since the first, so the
	# constant-velocity seed was being flattened every other frame.
	option ring '192.168.1.255:7602'

	# How often the JSON status file is rewritten, in milliseconds. The
	# on-router dashboard polls that file.
	option status_interval '200'

	# Script run as '<script> alarm' / '<script> clear' on zone changes.
	option action ''

# Polar zones. az_start/az_end in degrees clockwise from the sensor's zero,
# range in metres.
#config zone
#	option az_start '330'
#	option az_end '30'
#	option range '2.5'
#
#	# How many columns inside the zone must agree in one revolution before it
#	# fires. Firing on a single column is the safe direction taken alone, but
#	# a reflex that false-alarms on one dust return gets switched off by
#	# whoever works next to it, and a disabled reflex is worse than a
#	# slightly slower one. Still fires within a revolution, in milliseconds.
#	option confirm '2'
#
#	# How many consecutive quiet revolutions release it. One is not proof: a
#	# partly occluded object, or one at the edge of the selected elevation
#	# band, drops out for a rotation and comes back.
#	option clear_after '2'
#
#	# Release margin in metres. An active zone holds until the range clears
#	# range + this, so an object parked on the boundary does not chatter at
#	# the revolution rate.
#	option hysteresis '0.3'
