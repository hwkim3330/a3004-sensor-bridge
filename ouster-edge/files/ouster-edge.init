#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/ouster-edge
STATUS=/var/run/ouster-edge.json
WAITPID=/var/run/ouster-edge-wait.pid

append_zone() {
	local cfg="$1"
	local az_start az_end range confirm clear_after hysteresis

	config_get az_start "$cfg" az_start
	config_get az_end "$cfg" az_end
	config_get range "$cfg" range
	config_get confirm "$cfg" confirm 2
	config_get clear_after "$cfg" clear_after 2
	config_get hysteresis "$cfg" hysteresis 0.3

	[ -n "$az_start" ] && [ -n "$az_end" ] && [ -n "$range" ] || return 0
	procd_append_param command --zone \
		"${az_start}:${az_end}:${range}:${confirm}:${clear_after}:${hysteresis}"
}

start_service() {
	local enabled port sensor_ip channels columns scan_width sectors
	local channel_band min_range max_range relay ring status_interval action r
	local az_window

	config_load ouster-edge
	config_get_bool enabled lidar enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get port          lidar port 7502
	config_get sensor_ip     lidar sensor_ip
	config_get channels      lidar channels 64
	config_get columns       lidar columns 16
	config_get scan_width    lidar scan_width 1024
	config_get sectors       lidar sectors 360
	config_get channel_band  lidar channel_band
	config_get min_range     lidar min_range 0.3
	config_get max_range     lidar max_range 100
	config_get relay         lidar relay
	config_get ring          lidar ring
	config_get status_interval lidar status_interval 200
	config_get action        lidar action
	config_get_bool range_image lidar range_image 1
	config_get range_step    lidar range_step 2

	# Make the sensor what this router expects, before reading back what it
	# says. Its configuration does not survive its own reboot, and a wrong one
	# is silent - a 90 degree azimuth_window gave an empty ring, zero matches
	# and healthy counters everywhere, with nothing anywhere saying why.
	#
	# The same pass reads beam_altitude_angles and reports which rows are
	# horizontal, because the whole-array default makes the ring a picture of
	# the floor as soon as the sensor is on a vehicle, and the right indices
	# depend on the beam layout rather than being fixed.
	if [ -n "$sensor_ip" ]; then
		local cfgout auto_band
		#
		# Bounded, though not for the reason it looks like.
		#
		# A restart with no sensor attached took minutes, and the guess was
		# that an unanswered ARP on the router's own LAN was stalling the HTTP
		# attempt. Measured, one probe of an absent 192.168.1.50 returns in
		# 3.2 s ("Failed to send request: Operation not permitted"), so that
		# was wrong and the delay is elsewhere. The cap stays because a start
		# path that reaches out to hardware should have a bound on it either
		# way, and 8 s is generous for a sensor that is present; the
		# sensor-arrives-late case is handled by the background wait below.
		if cfgout="$(timeout 8 /usr/sbin/ouster-configure "$sensor_ip" --apply 2>&1)"; then
			logger -t ouster-edge "$(echo "$cfgout" | grep -v '^OUSTER_' | tr '\n' ' ')"
			auto_band="$(echo "$cfgout" | sed -n 's/^OUSTER_CHANNEL_BAND=//p')"
			if [ -z "$channel_band" ] && [ -n "$auto_band" ]; then
				channel_band="$auto_band"
				logger -t ouster-edge \
				  "channel_band unset; using the horizontal rows $channel_band"
			fi
		else
			#
			# The sensor is almost certainly still booting.
			#
			# This service starts late but the router still finishes before an
			# OS-1 serves HTTP, so reading the sensor here fails for reasons
			# that are only about ordering - and the log said "could not
			# configure sensor" as though something were wrong. Waiting here
			# would hold up procd for a minute, so the wait goes to the
			# background and this start proceeds with what it knows.
			#
			# The restart is guarded on channel_band still being empty, which
			# is the same condition that spawned this, so it happens once and
			# cannot loop: by the time it runs, the value is set.
			logger -t ouster-edge \
			  "sensor $sensor_ip not answering yet; waiting for it in the background"
			if [ -z "$channel_band" ]; then
				#
				# setsid, and a pid file.
				#
				# Backgrounding alone is not enough: a plain `&` leaves the
				# waiter in the service's process group, and procd's stop
				# signals that group and then waits for it. With no sensor
				# attached that wait is the waiter's own 180 seconds, so
				# `/etc/init.d/ouster-edge restart` did not return for five
				# minutes - measured, with the service's new pid already in
				# place long before the shell came back. A new session detaches
				# it; stop_service kills it by pid, so a stopped service does
				# not leave something polling hardware.
				# 1000>&- as well as inside the waiter: the fd this closes
				# is procd's service lock, and leaving it open in a child that
				# lives for three minutes is what made restart block. Closed on
				# both sides so neither file has to be read to know it is safe.
				setsid /usr/sbin/ouster-wait-band "$sensor_ip" 180 \
					>/dev/null 2>&1 1000>&- &
				echo $! > "$WAITPID"
			fi
		fi
	fi

	# Prefer what the sensor reports over what is configured here - the
	# lidar mode can be changed on the sensor without anyone updating UCI.
	if [ -n "$sensor_ip" ]; then
		# Capture first and test the *command's* status. eval returns the
		# status of the string it evaluated, so `eval "$(cmd)"` with a
		# failing cmd evaluates "" and succeeds - which logged "sensor
		# reports ..." with the fallback values while no sensor was
		# reachable at all. That is a lie at exactly the moment someone
		# is trying to find out whether the sensor is talking.
		local meta
		# Bounded for the same reason as the probe above.
		if meta="$(timeout 8 /usr/sbin/ouster-metadata "$sensor_ip" 2>/dev/null)" &&
		   [ -n "$meta" ]; then
			eval "$meta"
			channels="${OUSTER_CHANNELS:-$channels}"
			columns="${OUSTER_COLUMNS:-$columns}"
			scan_width="${OUSTER_SCAN_WIDTH:-$scan_width}"
			az_window="${OUSTER_AZ_WINDOW:-}"
			logger -t ouster-edge \
			  "sensor $sensor_ip reports ${channels}ch x ${columns}col, width ${scan_width}, profile ${OUSTER_PROFILE:-unknown}"
		else
			logger -t ouster-edge \
			  "sensor $sensor_ip unreachable, using configured layout ${channels}ch x ${columns}col"
		fi
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		--port "$port" \
		--channels "$channels" \
		--columns "$columns" \
		--scan-width "$scan_width" \
		--sectors "$sectors" \
		--min-range "$min_range" \
		--max-range "$max_range" \
		--status "$STATUS" \
		--status-interval "$status_interval"

	[ -n "$az_window" ] && procd_append_param command --azimuth-window "$az_window"
	[ -n "$channel_band" ] && procd_append_param command --channel-band "$channel_band"
	[ -n "$relay" ] && procd_append_param command --relay "$relay"
	# /var/run so it lands in tmpfs, and symlinked into /www/sensors by the
	# dashboard package like the status file and the map.
	[ "$range_image" = "1" ] && {
		procd_append_param command --range-image /var/run/range.bin
		procd_append_param command --range-step "$range_step"
	}
	# One --ring per destination. A list here rather than a single value
	# because the on-router mapper and the operator's screen both want it, and
	# with one destination choosing either silently blanks the other.
	for r in $ring; do
		procd_append_param command --ring "$r"
	done
	[ -n "$action" ] && procd_append_param command --action "$action"

	config_foreach append_zone zone

	# Paced rather than unlimited-and-instant: a device that is not
	# plugged in yet must not become a hot restart loop.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$STATUS"
	# Anything still waiting for a sensor belongs to the service that asked
	# for it. Leaving it behind means a stopped service keeps polling
	# hardware, and a later start finds a second one doing the same.
	if [ -f "$WAITPID" ]; then
		kill "$(cat "$WAITPID")" 2>/dev/null
		rm -f "$WAITPID"
	fi
}

service_triggers() {
	procd_add_reload_trigger "ouster-edge"
}
