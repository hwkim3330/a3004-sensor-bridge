#!/bin/sh /etc/rc.common

START=93
USE_PROCD=1

start_service() {
	local enabled port map_size res maxr win wina minret sint mpath mint mexp mlvl

	config_load slam2d
	config_get_bool enabled map enabled 0
	[ "$enabled" = 1 ] || {
		logger -t slam2d "disabled in /etc/config/slam2d"
		return 0
	}

	config_get port         map port           7602
	config_get map_size     map map_size_cm    4000
	config_get res          map resolution_cm  5
	config_get maxr         map max_range_cm   3000
	config_get win          map window_cm      40
	config_get wina         map window_angle   120
	config_get minret       map min_returns    40
	config_get sint         map status_interval 500
	config_get mpath        map map_path
	config_get mexp         map map_export
	config_get mlvl         map map_level        2
	config_get mint         map map_interval   5000

	# A ring that is a minimum over every beam maps the floor, not the room.
	# Cannot be checked from here - the ring carries ranges, not which
	# channels produced them - so say it once at start rather than never.
	local band
	band="$(uci -q get ouster-edge.lidar.channel_band)"
	[ -n "$band" ] || logger -t slam2d \
		"ouster-edge has no channel_band set: the ring is a minimum over" \
		" every beam, which on a vehicle is the floor. See doc/COMPUTE.md."

	procd_open_instance
	procd_set_param command /usr/sbin/slam2d-daemon \
		-p "$port" -m "$map_size" -r "$res" -R "$maxr" \
		-w "$win" -a "$wina" -n "$minret" -I "$sint"
	[ -n "$mpath" ] && procd_append_param command -M "$mpath" -T "$mint"
	[ -n "$mexp" ] && procd_append_param command -X "$mexp" -L "$mlvl"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "slam2d" "ouster-edge"
}
