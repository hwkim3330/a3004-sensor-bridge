config slam2d 'map'
	# Off by default. Mapping is only meaningful once ouster-edge is
	# publishing a near-horizontal slice rather than its default minimum
	# over every beam - see doc/COMPUTE.md, and set ouster-edge's
	# channel_band first. Enabling this before that produces a map of the
	# floor, which looks like a small circle and never grows.
	option enabled '0'

	option port '7602'
	option map_size_cm '4000'
	option resolution_cm '5'
	option max_range_cm '3000'

	# How far the vehicle may move between revolutions. 40 cm at 10 Hz is
	# 4 m/s, comfortably above what a SCOUT MINI does; raising it costs
	# search time on the coarsest pyramid level only.
	option window_cm '40'
	option window_angle '120'

	option min_returns '40'
	option status_interval '500'

	# Served by the dashboard as /sensors/map.s2mp for a client to draw.
	# Level 2 is 20 cm cells, 40 kB for a 40 m map - small enough to poll
	# over WiFi several times a second.
	option map_export '/var/run/map.s2mp'
	option map_level '2'

	# Uncomment to have the map written where the dashboard can fetch it.
	# option map_path '/tmp/slam2d.pgm'
	# option map_interval '5000'
