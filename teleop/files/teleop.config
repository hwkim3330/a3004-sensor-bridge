config teleop 'control'
	# Off by default. Turning this on means a tablet can command something;
	# read doc/TELEOP.md first, in particular the part about the receiver
	# needing its own deadman.
	option enabled '0'

	option port '8083'

	# Where intent goes. Empty means the daemon only tracks state for the
	# dashboard and forwards nothing, which is a useful way to try the
	# joystick out with nothing connected.
	option remote ''

	# A copy of every accepted frame, broadcast, for anything that wants to
	# watch rather than act.
	#
	# This is what makes a demonstration recordable no matter who is driving.
	# A behaviour-cloning recorder needs the scan the operator was looking at
	# and the intent they gave; the scan is already broadcast as the ring, and
	# until this existed the intent only existed inside whichever console was
	# being used - so driving from the tablet, which is what somebody walking
	# behind the vehicle uses, could not be recorded at all.
	#
	# Independent of `remote`: agx-cmd is off by default, so nothing is being
	# forwarded most of the time, and the intent is still worth keeping.
	option echo '192.168.1.255:7723'

	# Forward cadence. Frames are sent at this rate whether armed or not, so
	# the receiver can tell "neutral" from "gone".
	option rate '20'

	# UDP command input, which is what the native Android client uses. A
	# browser has to send one HTTP request per command; an app does not, and
	# that removes the connection-limit problems that path ran into.
	option cmd_port '7721'

	# Deadman: after this long with no command, output goes neutral and the
	# armed flag drops. Clamped to at least two forward intervals, because a
	# deadman that trips on ordinary jitter trains people to ignore it.
	option timeout '300'
