config mic 'capture'
	option enabled '1'

	# plughw, not hw: the Logitech StreamCam only offers stereo, so asking
	# hw: for mono fails outright. plughw lets ALSA downmix, which halves the
	# bandwidth for a downmix cost of nothing at 16 kHz.
	option device 'plughw:0,0'

	option rate '16000'
	option channels '1'

	# ALSA period in frames. This is the floor on capture latency:
	# 160 frames at 16 kHz = 10 ms.
	option period '160'

	option port '8082'
