#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/mic-stream

start_service() {
	local enabled device rate channels period port

	config_load mic-stream
	config_get_bool enabled capture enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get device   capture device 'plughw:0,0'
	config_get rate     capture rate 16000
	config_get channels capture channels 1
	config_get period   capture period 160
	config_get port     capture port 8082

	procd_open_instance
	procd_set_param command "$PROG" \
		--device "$device" \
		--rate "$rate" \
		--channels "$channels" \
		--period "$period" \
		--port "$port"
	# Paced rather than unlimited-and-instant: a device that is not
	# plugged in yet must not become a hot restart loop.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mic-stream"
}
