#!/bin/sh
# Wire the sensor bridge into UCI. Runs once, on first boot.

. /lib/functions.sh

# --- camera ---------------------------------------------------------------
# 1280x720 MJPEG straight from the camera. On MT7621 the only viable mode is
# pass-through: the SoC has no JPEG encoder, so 'format MJPEG' must be what
# the camera itself produces. Run sensor-probe to confirm before raising this.
# The frame rate was measured end to end - at the router, on the wire, and on the
# tablet over wifi - rather than reasoned about from bitrate. What the tablet
# actually sustains:
#
#   out  tablet over wifi   ustreamer  loadavg
#    20  20.0 fps, 0 late         29%     2.76
#    30  29.9 fps, 0 late         41%     3.64
#    60  58-60 fps, 0-1 late      93%     4.38
#
# And over 90 s per setting, which is what shows the tail the mapper cares about:
#
#   out  rings matched  match median  worst, of the 100 ms ring interval
#    30      899/899        38.1 ms    48.1 ms  (48%)
#    60      902/902        53.4 ms    91.9 ms  (92%)
#
# 60 fps works. The tablet holds it over wifi with nothing dropped, the lidar
# misses no columns and every ring is still matched - the earlier note here said
# 95 Mbit/s "does not fit 2.4 GHz at all", and the delivered figure at 60 is
# 62 Mbit/s on 5 GHz, so that was too pessimistic.
#
# The default is 30 because of that last column, not the bandwidth. Serving 60 fps
# costs a whole core of four and leaves the mapper 8 ms of its 100 ms interval in
# the worst case, with the match score floor dropping from 83% to 74%. Nothing is
# dropped today, but the vehicle is not driving today either, and navigate wants
# the same cpu when it is. 30 doubles the smoothness of 20 and still leaves the
# mapper half its interval.
#
# Raise it to 60 when the camera is what matters and the vehicle is parked.
#
# quality is left at 80 but is NOT the knob to turn: with an MJPEG source the
# camera does the encoding and ustreamer relays, so dropping 80 to 70 changed the
# frame size by under 2% and only the frame rate actually moved the bitrate.
# Reducing bytes per frame means re-encoding on the CPU or changing the camera's
# own v4l2 controls.
uci -q batch <<'EOF'
set ustreamer.video0=ustreamer
set ustreamer.video0.enabled='1'
set ustreamer.video0.device='/dev/video0'
set ustreamer.video0.resolution='1280x720'
set ustreamer.video0.format='MJPEG'
# HW rather than CPU, but not for the reason first given, and it changes nothing.
#
# The claim here was that CPU makes ustreamer decode the camera's MJPEG and
# re-encode it in software, and that this cost the 28.2% of a CPU measured with a
# client attached. Both halves were wrong, and ustreamer's own --help said so:
# "It does not re-encode MJPEG to MJPEG ... for sources that already output
# MJPEG." Measured on the board with a client pulling, everything else fixed:
#
#   encoder=HW    25.9% of one cpu   624 frames   172 kB each   29.3 Mbit/s
#   encoder=CPU   25.8% of one cpu   626 frames   172 kB each   29.4 Mbit/s
#
# Identical, and the frames are the same size, which is the proof that nothing
# was being re-encoded either way.
#
# What the cost actually is: serving the bytes. With no client ustreamer runs at
# 0.7% at 10 fps and 2.9% at 60. Attach one client pulling 29 Mbit/s and it is
# 26%. So the knob that matters is how many bytes leave the router - resolution
# and frame rate - and not the encoder. workers has no effect either: 1 and 2
# measured the same.
#
# HW stays because it states the intent plainly for an MJPEG source. It is not a
# fix for anything.
set ustreamer.video0.encoder='HW'
set ustreamer.video0.desired_fps='30'
set ustreamer.video0.quality='80'
set ustreamer.video0.host='0.0.0.0'
set ustreamer.video0.port='8080'
set ustreamer.video0.drop_same_frames='0'
set ustreamer.video0.buffers='2'
set ustreamer.video0.workers='2'
set ustreamer.video0.tcp_nodelay='1'
commit ustreamer
EOF

# --- lidar ----------------------------------------------------------------
# Enabled but pointed at nothing downstream by default: the ring is published
# into the status file for the dashboard, and raw relaying stays off until a
# destination is configured.
uci -q batch <<'EOF'
set ouster-edge.lidar.enabled='1'
# The IMU, which the sensor sends whether or not anyone listens. It answers the
# one question a range scan cannot: whether the vehicle is level. A 2D map assumes
# it is, and a ramp makes that assumption quietly false.
set ouster-edge.lidar.imu_port='7503'
# The range image, at full vertical resolution.
#
# It is what the lidar console draws its point cloud from, so the row step is the
# cloud's vertical resolution: 1 gives 64 rows, 2 gives 32. Measured on the board
# with the camera unplugged - which is the configuration this is for, since the USB
# port is CAN's:
#
#   step 2   ouster-edge 19% of a core   range.bin 23 kB   loadavg 2.1
#   step 1   ouster-edge 29% of a core   range.bin 46 kB   loadavg 1.0
#
# No missed columns either way and slam2d kept matching every ring, and 46 kB three
# times a second is 138 kB/s, which wifi does not notice. The camera's 41% of a core
# pays for it.
set ouster-edge.lidar.range_image='1'
set ouster-edge.lidar.range_step='1'
commit ouster-edge
EOF

# Give the lidar a stable address. Ouster sensors default to DHCP and fall back
# to link-local, so a reservation is what makes the sensor findable again after
# a power cycle.
if ! uci -q get dhcp.ouster >/dev/null; then
	uci -q batch <<'EOF'
set dhcp.ouster=host
set dhcp.ouster.name='ouster'
set dhcp.ouster.ip='192.168.1.50'
set dhcp.ouster.leasetime='infinite'
commit dhcp
EOF
	logger -t sensorkit "reserved 192.168.1.50 for the lidar; set dhcp.ouster.mac to its MAC"
fi

# --- firewall -------------------------------------------------------------
# Camera (8080), lidar ring push (7603), microphone (8082) and teleop
# (8083) are LAN-only.
# Nothing is opened on WAN.
if ! uci -q get firewall.sensorkit_stream >/dev/null; then
	uci -q batch <<'EOF'
set firewall.sensorkit_stream=rule
set firewall.sensorkit_stream.name='Allow-SensorKit-LAN'
set firewall.sensorkit_stream.src='lan'
set firewall.sensorkit_stream.proto='tcp'
set firewall.sensorkit_stream.dest_port='7603 8080 8082 8083'
set firewall.sensorkit_stream.target='ACCEPT'
commit firewall
EOF
fi

# --- wifi -----------------------------------------------------------------
# Both radios exist only when the DBDC override in the device tree is working.
# Bring up the 5 GHz one as the data-carrying AP for a tablet, and leave 2.4
# for control/fallback. Radios stay disabled=0 but the password must be set by
# hand - shipping a default one would be worse than making it a visible step.
for r in 0 1; do
	uci -q get wireless.radio$r >/dev/null || continue
	uci -q set wireless.radio$r.disabled='0'
	uci -q set wireless.radio$r.country='KR'
done

band0="$(uci -q get wireless.radio0.band)"
band1="$(uci -q get wireless.radio1.band)"
logger -t sensorkit "radio0 band=${band0:-unknown} radio1 band=${band1:-unknown}"

if [ -z "$band1" ]; then
	logger -t sensorkit "WARNING: only one radio present - DBDC override is not active, see doc/DBDC.md"
fi

#
# The access points themselves.
#
# Enabling the radios is not enough: OpenWrt's default interfaces stay disabled
# with the SSID "OpenWrt" and no encryption, so a tablet looking for this router
# finds nothing and the one that matters - the app's AP button - has nothing to
# join. Every other surface in this kit was configured here and this one was not.
#
# Named per band from what the driver reports, so the 5 GHz one is the 5 GHz one
# whichever phy it landed on. The passphrase is a default for a bench device, not
# a secret; if this is ever pointed at something that matters, change it here and
# in the app together.
for r in 0 1; do
	uci -q get wireless.radio$r >/dev/null || continue
	band="$(uci -q get wireless.radio$r.band)"
	case "$band" in
		5g) name="A3004-5G" ;;
		2g) name="A3004-2G" ;;
		*)  name="A3004-$r" ;;
	esac
	sec="$(uci -q show wireless | sed -n "s/^wireless\.\(default_radio$r\)=wifi-iface$/\1/p")"
	[ -n "$sec" ] || sec="default_radio$r"
	uci -q set wireless.$sec=wifi-iface
	uci -q set wireless.$sec.device="radio$r"
	uci -q set wireless.$sec.network='lan'
	uci -q set wireless.$sec.mode='ap'
	uci -q set wireless.$sec.ssid="$name"
	uci -q set wireless.$sec.encryption='psk2'
	uci -q set wireless.$sec.key='keti12345678'
	uci -q set wireless.$sec.disabled='0'
	logger -t sensorkit "access point $name on radio$r (${band:-unknown band})"
done

uci -q commit wireless

# --- microphone -----------------------------------------------------------
# The StreamCam only offers stereo, so hw: with mono fails outright; plughw
# lets ALSA downmix. On the router the USB card is the only card, so index 0.
uci -q batch <<'EOF'
set mic-stream.capture.enabled='1'
set mic-stream.capture.device='plughw:0,0'
commit mic-stream
EOF

logger -t sensorkit "sensor bridge configured; dashboard at http://192.168.1.1/sensors/"
exit 0
